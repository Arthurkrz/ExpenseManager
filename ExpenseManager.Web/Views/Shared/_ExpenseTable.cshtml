@using ExpenseManager.Web.Models
@model IEnumerable<ExpenseViewModel>

@if (Model.Any())
{
    <div class="row">
        <div class="col-12">
            <table class="table table-striped table-hover text-center">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Currency</th>
                        <th>Value</th>
                        <th>Source</th>
                        <th>Date of expense</th>
                        <td></td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model)
                    {
                        <tr>
                            <td>@expense.Name</td>
                            <td>@expense.Type</td>
                            <td>@expense.Currency</td>
                            <td>@expense.ValueString</td>
                            <td>@expense.Source</td>
                            <td>@expense.ExpenseDate?.ToString("dd/MM/yyyy")</td>
                            <td>
                                <button style="margin-left: 10px" type="button" 
                                    class="btn p-0 border-0 bg-transparent" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#editModal-@expense.Id">
                                    <i class="fa-solid fa-pen-to-square" style="color: #ffc800;"></i>
                                </button>
                                <button type="button" style="margin-left: 5px" 
                                    class="btn p-0 border-0 bg-transparent" 
                                    data-bs-toggle="modal" 
                                    data-bs-target="#deleteModal-@expense.Id">
                                    <i class="fa-solid fa-trash" style="color: #ff0000;"></i>
                                </button>
                            </td>
                        </tr>
                        <partial name="_EditModal" model="expense" />
                        <partial name="_DeleteModal" model="expense" />
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <h1 style="text-align: center; font-weight: bold; font-size: 24px; margin-right: 55px; padding-top: 50px;">
        No expenses found!
    </h1>
}