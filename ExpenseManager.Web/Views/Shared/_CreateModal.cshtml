@using ExpenseManager.Web.Models
@using ExpenseManager.Web.Models.Enum
@model ExpenseViewModel

<div id="modalContainer">
    <div class="modal fade"
         id="createExpenseModal"
         tabindex="-1"
         aria-labelledby="createExpenseModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="createExpenseModalLabel">
                        Add new expense
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body create-modal-body">
                    <form method="post"
                          asp-controller="Expense"
                          asp-action="Create"
                          id="createExpenseForm"
                          novalidate>

                        <div id="errorMessages" class="alert alert-danger d-none"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="row mt-1">
                            <div class="col-6">
                                <label asp-for="Name" class="form-label"></label>
                                <textarea asp-for="Name"
                                          class="form-control mt-1 create-modal-textarea"
                                          placeholder="Name">
                                </textarea>
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-6">
                                <label asp-for="ExpenseDate" class="form-label">
                                    Expense date
                                </label>
                                <input asp-for="ExpenseDate"
                                       class="form-control mt-1"
                                       type="date"
                                       required />
                                <span asp-validation-for="ExpenseDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <label asp-for="Type" class="form-label">
                                    Category
                                </label>
                                <select asp-for="Type"
                                        asp-items="@Html.GetEnumSelectList<ExpenseTypeVM>()"
                                        class="form-control mt-0">
                                    <option value="" selected>Select</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-12">
                                <label asp-for="Source" class="form-label">
                                    Expense source
                                </label>
                                <textarea asp-for="Source"
                                          class="form-control mt-0 create-modal-textarea"
                                          placeholder="Expense source">
                                </textarea>
                                <span asp-validation-for="Source" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-6">
                                <label asp-for="Currency" class="form-label">
                                    Currency
                                </label>
                                <select asp-for="Currency"
                                        asp-items="@Html.GetEnumSelectList<CurrencyVM>()"
                                        class="form-control mt-0">
                                    <option value="" selected>Select</option>
                                </select>
                                <span asp-validation-for="Currency" class="text-danger"></span>
                            </div>

                            <div class="col-6">
                                <label asp-for="ValueString" class="form-label">
                                    Value
                                </label>
                                <input asp-for="ValueString"
                                       class="form-control mt-0"
                                       type="number"
                                       step="0.01" />
                                <span asp-validation-for="ValueString" class="text-danger"></span>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="modal-footer create-modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            form="createExpenseForm"
                            id="saveExpenseButton"
                            class="btn btn-primary">
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>