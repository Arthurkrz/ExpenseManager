@using ExpenseManager.Web.Models
@using System.Text.Json
@model PaginatedViewModel<ExpenseViewModel>

@{
    ViewData["Title"] = "Expenses"; 

    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;

    var pageTotalsByCurrency = ViewBag.PageTotalsByCurrency as 
        Dictionary<string, decimal> ?? 
            new Dictionary<string, decimal>();

    var allTotalsByCurrency = ViewBag.AllTotalsByCurrency as
        Dictionary<string, decimal> ??
            new Dictionary<string, decimal>();
}

@section Styles {
	<link rel="stylesheet" href="~/css/expense/expenses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/create-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/expense-table.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.expensePageTotals = @Html.Raw(JsonSerializer.Serialize(pageTotalsByCurrency))
        window.expenseAllTotals = @Html.Raw(JsonSerializer.Serialize(allTotalsByCurrency))
    </script>

    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/expense/index.js" asp-append-version="true"></script>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div id="successAlert" class="alert alert-success expense-success-alert" role="alert">
        <div class="success-alert-message">@successMessage</div>

        <div class="progress mt-2 success-progress">
            <div id="successProgressBar" 
                class="progress-bar progress-bar-animated success-progress-bar"
                role="progressbar">
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger text-center" role="alert">
        @Html.Raw(errorMessage)
    </div>
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="m-0 expenses-count-title">
            Showing @Model.Items.Count of @Model.TotalCount @(Model.TotalCount == 1 ? "expense" : "expenses")
        </h1>

        <h1 id="totalAmount" class="mt-3 total-amount"></h1>

        <div>
            <a class="btn btn-primary me-2" 
                asp-action="Filter" 
                asp-controller="Expense">
                 Search
            </a>

            <a id="addExpenseButton" 
                class="btn btn-success text-white" 
                data-bs-toggle="modal" 
                data-bs-target="#createExpenseModal">
                 Add expense
            </a>
        </div>
    </div>
</div>

<div class="container">
    <partial name="_ExpenseTable" model="Model.Items" />
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize">
                    Previous
                </a>
            </li>

            @for (var pageNum = 1; pageNum <= Model.TotalPages; pageNum++)
            {
                <li class="page-item @(pageNum == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-pageNumber="@pageNum"
                       asp-route-pageSize="@Model.PageSize">
                        @pageNum
                    </a>
                </li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}

<partial name="_CreateModal" model="new ExpenseViewModel()" />

<div class="d-flex align-items-center mt-1">
    <label for="currencySelect" class="me-2 mb-0 currency-total-selector">
        Display total in:
    </label>

    <select id="currencySelect" class="form-select w-auto">
        <option value="USD" selected>American Dollars ($)</option>
        <option value="EUR">Euros (€)</option>
        <option value="BRL">Brazilian Reais (R$)</option>
        <option value="GBP">British Pounds (£)</option>
        <option value="CAD">Canadian Dollars ($)</option>
        <option value="JPY">Japanese Yen (¥)</option>
    </select>
</div>